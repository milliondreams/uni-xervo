{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FastEmbed Provider Options",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cache_dir": {
      "type": "string",
      "description": "Path to the per-model cache directory."
    },
    "execution_providers": {
      "type": "array",
      "description": "Preferred ONNX Runtime execution providers in priority order.",
      "items": {
        "type": "string",
        "enum": [
          "cpu",
          "cuda"
        ]
      },
      "minItems": 1
    }
  }
}
